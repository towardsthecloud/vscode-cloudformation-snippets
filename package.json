{
  "name": "cloudformation-yaml-snippets",
  "displayName": "AWS CloudFormation Snippets",
  "description": "Adds snippets for all the AWS CloudFormation resources in VS Code.",
  "author": "Danny Steenman",
  "version": "5.129.0",
  "publisher": "dannysteenman",
  "icon": "images/cfn-snippets-extension-icon.png",
  "homepage": "https://towardsthecloud.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/towardsthecloud/vscode-cloudformation-snippets.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "galleryBanner": {
    "color": "#2B2C33",
    "theme": "dark"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "aws",
    "cloudformation",
    "sam",
    "iac",
    "yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --noEmit && node scripts/build.cjs",
    "watch": "node scripts/build.cjs --watch",
    "test": "npm run compile && node tests/run-extension-tests.cjs",
    "package": "vsce package --out .vscode-test/cloudformation-snippets.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "json",
        "aliases": [
          "JSON",
          "json"
        ],
        "extensions": [
          ".json",
          ".template"
        ]
      },
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ]
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/json-general.json"
      },
      {
        "language": "json",
        "path": "./snippets/json-cfn-resource-types.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-condition-functions.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-general.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-intrinsic-functions.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-parameter-types.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-cfn-resource-types.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-sam-resource-types.json"
      }
    ]
  },
  "extensionPack": [
    "redhat.vscode-yaml"
  ]
}
